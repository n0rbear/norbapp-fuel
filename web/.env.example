# Copy to .env.local for local development. Nothing here is required.

# NorbApp FUEL-API (fuel prices, tolls, currencies). Default: the live instance.
# FUEL_API_URL=https://norbapp-fuel-api-fra.onrender.com

# Optional: self-hosted OpenStreetMap services (defaults: public instances).
# OSRM_URL=https://routing.openstreetmap.de/routed-car
# PHOTON_URL=https://photon.komoot.io
